<?xml version="1.0"?>

<!--
  Built with wixl from msitools (0.106 or later), see build-msi.sh.

  Required preprocessor variables:
    Version    - MSI ProductVersion (major.minor.patch)
    DistDir    - GoReleaser dist directory containing the Windows binaries
    PolicyDir  - directory containing the Group Policy ADMX/ADML files
    LicenseRtf - licence converted to RTF for the licence agreement dialog
-->

<?if $(sys.BUILDARCH)="x86"?>
    <?define Program_Files="ProgramFilesFolder"?>
<?else?>
    <?define Program_Files="ProgramFiles64Folder"?>
<?endif?>

<?define Product="Serverless SSH CA Client"?>
<?define Company="Andrew Heberle"?>
<?define UpgradeCode="75b8e17f-138e-447e-bf35-c093ab5293e8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

   <Product Id="*" UpgradeCode="$(var.UpgradeCode)"
            Name="$(var.Product)"
            Version="$(var.Version)"
            Manufacturer="$(var.Company)"
            Language="1033">

      <Package InstallerVersion="200" Compressed="yes" Comments="Windows Installer Package" InstallScope="perMachine"/>

      <Media Id="1" Cabinet="product.cab" EmbedCab="yes"/>

      <Upgrade Id="$(var.UpgradeCode)">
         <UpgradeVersion Minimum="$(var.Version)" OnlyDetect="yes" Property="NEWERVERSIONDETECTED"/>
         <UpgradeVersion Minimum="0.0.0" Maximum="$(var.Version)" IncludeMinimum="yes" IncludeMaximum="no"
                         Property="OLDERVERSIONBEINGUPGRADED"/>
      </Upgrade>
      <Condition Message="A newer version of this software is already installed.">NOT NEWERVERSIONDETECTED</Condition>

      <!--
      Reinstall files of an equal version ("e"), not only missing or older
      ones ("o", the default). An upgrade decides which files to copy before
      RemoveExistingProducts removes the old version, so a file of an equal
      version that was left in place would then be removed with it. The
      client's version resource does not change between releases. The files
      are private to this product, so replacing one of an equal version is
      safe.
      -->
      <Property Id="REINSTALLMODE" Value="emus" />

      <!--
      Install options, given on the msiexec command line:
        msiexec /i ssh-ca-client.msi /qn INSTALLDIR="D:\Tools\SSH CA\" START_ON_LOGIN=0 START_SSH_AGENT=0

      The options an install used are saved under the Installer subkey of the
      config key (C.InstallerOptions), and an upgrade reuses them, so a custom
      install directory or a disabled option is kept. Each option takes, in
      order: the command line, the saved value, then the default, which is
      Program Files for INSTALLDIR and enabled (1) for the others. The client
      ignores the Installer subkey when it loads the config.

      The saved values are read by AppSearch, which runs before
      RemoveExistingProducts removes the old install and its saved values.
      The options are then set by the custom actions below, which run once:
      in the UI sequence, or in the execute sequence for a silent install.
      START_ON_LOGIN and START_SSH_AGENT are left unset when disabled, rather
      than "0", as a checkbox is ticked whenever its property has a value. The
      Unset actions set them to [NoValue], a property that is never set, which
      removes them.
      -->
      <Property Id="START_ON_LOGIN" Secure="yes" />
      <Property Id="START_SSH_AGENT" Secure="yes" />

      <Property Id="INSTALLDIR_SAVED">
         <RegistrySearch Id="SearchInstallDir" Root="HKLM"
                         Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                         Name="InstallDir" Type="raw" />
      </Property>
      <Property Id="START_ON_LOGIN_SAVED">
         <RegistrySearch Id="SearchStartOnLogin" Root="HKLM"
                         Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                         Name="StartOnLogin" Type="raw" />
      </Property>
      <Property Id="START_SSH_AGENT_SAVED">
         <RegistrySearch Id="SearchStartSSHAgent" Root="HKLM"
                         Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                         Name="StartSSHAgent" Type="raw" />
      </Property>

      <CustomAction Id="RestoreInstallDir" Property="INSTALLDIR" Value="[INSTALLDIR_SAVED]" Execute="firstSequence" />
      <CustomAction Id="RestoreStartOnLogin" Property="START_ON_LOGIN" Value="[START_ON_LOGIN_SAVED]" Execute="firstSequence" />
      <CustomAction Id="DefaultStartOnLogin" Property="START_ON_LOGIN" Value="1" Execute="firstSequence" />
      <CustomAction Id="UnsetStartOnLogin" Property="START_ON_LOGIN" Value="[NoValue]" Execute="firstSequence" />
      <CustomAction Id="RestoreStartSSHAgent" Property="START_SSH_AGENT" Value="[START_SSH_AGENT_SAVED]" Execute="firstSequence" />
      <CustomAction Id="DefaultStartSSHAgent" Property="START_SSH_AGENT" Value="1" Execute="firstSequence" />
      <CustomAction Id="UnsetStartSSHAgent" Property="START_SSH_AGENT" Value="[NoValue]" Execute="firstSequence" />

      <!--
      The values saved for the options: "1" when enabled and "0" when
      disabled, as an empty value would read back as nothing saved. Set in the
      execute sequence, which writes them.
      -->
      <Property Id="StartOnLoginValue" Value="0" />
      <Property Id="StartSSHAgentValue" Value="0" />
      <CustomAction Id="SaveStartOnLogin" Property="StartOnLoginValue" Value="1" />
      <CustomAction Id="SaveStartSSHAgent" Property="StartSSHAgentValue" Value="1" />

      <Directory Id="TARGETDIR" Name="SourceDir">

         <Directory Id="$(var.Program_Files)">
            <Directory Id="INSTALLDIR" Name="$(var.Product)">
               <!--
                 The key path is a registry value, not a program. With a
                 program as the key path, an upgrade that finds it already
                 installed at an equal version gives the component no install
                 action, and RemoveExistingProducts then removes both programs
                 with the old version. The value records the installed
                 version, in the Installer subkey the client ignores.
               -->
               <Component Id="ApplicationFiles" Guid="66807fd7-177d-4462-822a-24211b9fb0f1">
                  <File Id="ApplicationFile0" Source="$(var.DistDir)/gui_windows_amd64_v1/ssh-ca-client.exe"/>
                  <File Id="ApplicationFile1" Source="$(var.DistDir)/cli_windows_amd64_v1/ssh-ca-client-cli.exe"/>
                  <RegistryValue Root="HKLM"
                                 Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                                 Name="Version"
                                 Type="string"
                                 Value="[ProductVersion]"
                                 KeyPath="yes" />
               </Component>

               <!--
                 Group Policy templates.
               -->
               <Directory Id="APPDIR0" Name="policy">
                  <Component Id="C.PolicyADMX" Guid="2f0c6f0e-5d2b-4b8e-9a51-6f3d2c7b1a40">
                     <File Id="PolicyADMX" Source="$(var.PolicyDir)/ServerlessSSHCAClient.admx" KeyPath="yes"/>
                  </Component>
                  <Directory Id="APPDIR0_EN_US" Name="en-US">
                     <Component Id="C.PolicyADML" Guid="8b4e1d3a-7c62-4f05-b9d8-1e5a6c3f2d71">
                        <File Id="PolicyADML" Source="$(var.PolicyDir)/en-US/ServerlessSSHCAClient.adml" KeyPath="yes"/>
                     </Component>
                  </Directory>
               </Directory>
            </Directory>

            <!--
              Component: Event Log source registration.
            -->
            <Component Id="C.EventLog" Guid="6ccdcec5-b549-4ed1-8f60-65c9e78b05e7">
               <RegistryValue Root="HKLM"
                              Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Serverless SSH CA Client"
                              Name="EventMessageFile"
                              Type="expandable"
                              Value="%SystemRoot%\System32\EventCreate.exe"
                              KeyPath="yes" />
               <RegistryValue Root="HKLM"
                              Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Serverless SSH CA Client"
                              Name="TypesSupported"
                              Type="integer"
                              Value="7" />
            </Component>

            <!--
              Component: install options, read back on upgrade (see the
              properties above). Kept in a subkey of the config key, which the
              client ignores.
            -->
            <Component Id="C.InstallerOptions" Guid="7fdce4a8-1f18-4a02-8a73-45d3c4f2c152">
               <RegistryValue Root="HKLM"
                              Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                              Name="InstallDir"
                              Type="string"
                              Value="[INSTALLDIR]"
                              KeyPath="yes" />
               <RegistryValue Root="HKLM"
                              Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                              Name="StartOnLogin"
                              Type="string"
                              Value="[StartOnLoginValue]" />
               <RegistryValue Root="HKLM"
                              Key="SOFTWARE\$(var.Company)\$(var.Product)\Installer"
                              Name="StartSSHAgent"
                              Type="string"
                              Value="[StartSSHAgentValue]" />
            </Component>

            <!--
              Component: Run on login (HKLM).
              Condition restricts installation to when START_ON_LOGIN=1.
              MSI handles removal of the registry value on uninstall automatically.
              The path is quoted, as it can contain spaces, which Windows would
              otherwise split it on to find the program to run.
            -->
            <Component Id="C.RunOnLogin" Guid="b6a2ec5d-8254-43b9-a291-fa03b4944579">
               <Condition>START_ON_LOGIN = 1</Condition>
               <RegistryValue Root="HKLM"
                              Key="Software\Microsoft\Windows\CurrentVersion\Run"
                              Name="Serverless SSH CA Client"
                              Type="string"
                              Value="&quot;[INSTALLDIR]ssh-ca-client.exe&quot;"
                              KeyPath="yes" />
            </Component>

            <!--
              Component: Start OpenSSH Agent.
              Condition restricts installation to when START_SSH_AGENT=1.
              Adds ssh-agent.exe to the HKLM Run key so it starts at login for all
              users, this requires the OpenSSH Authentication Agent service to be set
              to "Manual" startup.
            -->
            <Component Id="C.SSHAgent" Guid="e7fe564c-a51c-4bc3-b790-16a11958bb72">
               <Condition>START_SSH_AGENT = 1</Condition>
               <RegistryValue Root="HKLM"
                              Key="Software\Microsoft\Windows\CurrentVersion\Run"
                              Name="OpenSSH Authentication Agent"
                              Type="expandable"
                              Value="&quot;%SystemRoot%\System32\OpenSSH\ssh-agent.exe&quot;"
                              KeyPath="yes" />
            </Component>
         </Directory>

         <Directory Id="ProgramMenuFolder">
            <Directory Id="ProgramMenuSubfolder" Name="$(var.Product)">
               <Component Id="ApplicationShortcuts" Guid="4d117172-5c8f-4389-ba93-58c9f35e6a0f">
                  <Shortcut Id="ApplicationShortcut0"
                            Name="$(var.Product)"
                            Description="$(var.Product)"
                            Target="[INSTALLDIR]ssh-ca-client.exe"
                            WorkingDirectory="INSTALLDIR" />
                  <RegistryValue Root="HKCU"
                                 Key="Software\$(var.Company)\$(var.Product)"
                                 Name="installed0"
                                 Type="integer" Value="1" KeyPath="yes"/>
                  <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall"/>
               </Component>
            </Directory>
         </Directory>

      </Directory>

      <!--
      Install options: see the properties above. The same actions are in both
      sequences, and run in the first. They have fixed numbers, so they run in
      order straight after AppSearch (50), and before CostFinalize (1000)
      resolves INSTALLDIR and the component conditions are checked, rather
      than wherever wixl's own ordering puts an action sequenced with After.
      -->
      <InstallUISequence>
         <Custom Action="RestoreInstallDir" Sequence="51">INSTALLDIR_SAVED AND NOT INSTALLDIR</Custom>
         <Custom Action="RestoreStartOnLogin" Sequence="52">START_ON_LOGIN_SAVED AND NOT START_ON_LOGIN</Custom>
         <Custom Action="DefaultStartOnLogin" Sequence="53">NOT START_ON_LOGIN</Custom>
         <Custom Action="UnsetStartOnLogin" Sequence="54">START_ON_LOGIN &lt;&gt; "1"</Custom>
         <Custom Action="RestoreStartSSHAgent" Sequence="55">START_SSH_AGENT_SAVED AND NOT START_SSH_AGENT</Custom>
         <Custom Action="DefaultStartSSHAgent" Sequence="56">NOT START_SSH_AGENT</Custom>
         <Custom Action="UnsetStartSSHAgent" Sequence="57">START_SSH_AGENT &lt;&gt; "1"</Custom>
      </InstallUISequence>

      <InstallExecuteSequence>
         <Custom Action="RestoreInstallDir" Sequence="51">INSTALLDIR_SAVED AND NOT INSTALLDIR</Custom>
         <Custom Action="RestoreStartOnLogin" Sequence="52">START_ON_LOGIN_SAVED AND NOT START_ON_LOGIN</Custom>
         <Custom Action="DefaultStartOnLogin" Sequence="53">NOT START_ON_LOGIN</Custom>
         <Custom Action="UnsetStartOnLogin" Sequence="54">START_ON_LOGIN &lt;&gt; "1"</Custom>
         <Custom Action="RestoreStartSSHAgent" Sequence="55">START_SSH_AGENT_SAVED AND NOT START_SSH_AGENT</Custom>
         <Custom Action="DefaultStartSSHAgent" Sequence="56">NOT START_SSH_AGENT</Custom>
         <Custom Action="UnsetStartSSHAgent" Sequence="57">START_SSH_AGENT &lt;&gt; "1"</Custom>
         <Custom Action="SaveStartOnLogin" Sequence="58">START_ON_LOGIN = "1"</Custom>
         <Custom Action="SaveStartSSHAgent" Sequence="59">START_SSH_AGENT = "1"</Custom>
         <RemoveExistingProducts After="InstallValidate"/>
      </InstallExecuteSequence>

      <Feature Id="DefaultFeature" Level="1">
         <ComponentRef Id="ApplicationFiles"/>
         <ComponentRef Id="ApplicationShortcuts"/>
         <ComponentRef Id="C.PolicyADMX" />
         <ComponentRef Id="C.PolicyADML" />
         <ComponentRef Id="C.EventLog" />
         <ComponentRef Id="C.InstallerOptions" />
         <ComponentRef Id="C.RunOnLogin" />
         <ComponentRef Id="C.SSHAgent" />
      </Feature>

      <!-- Define the installer UI -->
      <UIRef Id="WixUI_HK" />

      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

   </Product>

</Wix>

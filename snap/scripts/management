#!/bin/sh
#
# Helpers for the snap's hooks, which write the client's configuration from
# the snap options set with "snap set".
#

# required_options are the snap options the client can't run without. The
# others, scopes and redirect-url, are left out of the configuration when
# unset, so the client's defaults apply.
required_options="issuer client-id ca-url trusted-ca"

# all_options are every snap option written to the configuration
all_options="$required_options scopes redirect-url"

# get_value prints the snap option $1, and fails if it is unset or empty
get_value() {
    if [ $# -ne 1 ]; then
        return 1
    fi

    if ! v="$(snapctl get "$1")"; then
        return 1
    fi

    if [ -z "$v" ]; then
        return 1
    fi

    printf '%s\n' "$v"
}

# has_config_set succeeds when every required snap option is set
has_config_set() {
    for o in $required_options; do
        if ! get_value "$o" >/dev/null; then
            return 1
        fi
    done
}

# has_control_chars succeeds when $1 contains a newline or any other control
# character, which can't be written in a YAML string here
has_control_chars() {
    case "$1" in
        *[[:cntrl:]]*) return 0 ;;
    esac

    return 1
}

# yaml_string prints $1 as a double-quoted YAML string, so a value containing
# ": ", "#" or quotes is written exactly as given
yaml_string() {
    printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# yaml_list prints the comma separated list $1 as a YAML list of strings, with
# the spaces around each entry trimmed and empty entries dropped
yaml_list() {
    out=""
    old_ifs="$IFS"
    IFS=','
    set -f
    for item in $1; do
        item="$(printf '%s' "$item" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [ -z "$item" ]; then
            continue
        fi
        if [ -n "$out" ]; then
            out="$out, "
        fi
        out="$out$(yaml_string "$item")"
    done
    set +f
    IFS="$old_ifs"

    printf '[%s]' "$out"
}

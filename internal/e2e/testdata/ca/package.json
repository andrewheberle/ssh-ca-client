{
	"name": "ssh-ca-client-e2e-ca",
	"private": true,
	"description": "Runs the published Serverless SSH CA under Node.js for end-to-end tests of the client",
	"type": "module",
	"scripts": {
		"sync-schema": "node -e \"require('node:fs').copyFileSync(require.resolve('@andrewheberle/serverless-ssh-ca/openapi.json'), '../../../pkg/api/openapi.json')\" && go generate ../../../pkg/api"
	},
	"dependencies": {
		"@andrewheberle/serverless-ssh-ca": "0.19.1"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
